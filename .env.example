# ==============================================================================
# DISCORD BOT CONFIGURATION
# ==============================================================================
# Discord Bot Token (From Discord Developer Portal)
TOKEN=your_discord_bot_token_here

# Channel ID for receiving notifications and verifying new death regexes (leave empty to use livechat channel)
DEATH_VERIFY_CHANNEL_ID=

# ==============================================================================
# WEB SERVER & ENVIRONMENT
# ==============================================================================
# Enable/Disable Express Web Server Backend: "true" to enable, "false" to disable
ENABLE_BACKEND=false

# API Key protecting backend API routes
API_KEY=your_api_key_here

# Port for Express API/Web Server (Default: 3000 or 8181)
PORT=8181

# Execution environment: "development" or "production"
NODE_ENV=development

# Detailed debug logging: "true" or "false"
DEBUG=true

# ==============================================================================
# DATABASE (MONGODB) & CACHE (REDIS)
# ==============================================================================
# MongoDB connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/anarchy-bot

# Redis connection URL (Used for player online cache, session tracking, leaderboards)
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=anarchy

# ==============================================================================
# MINECRAFT BOT AUTHENTICATION
# ==============================================================================
# Minecraft authentication mode: "offline" (Cracked/Non-premium) or "microsoft" (Premium)
AUTH_MODE=offline

# --- Offline / Cracked Mode ---
# In-game username (IGN) when joining cracked servers
BOT_NAME=mo0nbot

# AuthMe login/register password (/login <pass> or /reg <pass> <pass>)
AUTHME=1011121314

# Security PIN (/pin <code>) if required by the server
PIN=1111

# --- Microsoft (Premium) Mode ---
MICROSOFT_EMAIL="your_microsoft_email@example.com"
MICROSOFT_PASSWORD="your_microsoft_password"

# ==============================================================================
# PRISMARINE 3D VIEWER & WEB MAP URL
# ==============================================================================
# Enable Prismarine 3D Web Viewer for Bot: "true" to enable, "false" to disable
VIEWER_ENABLED=false

# Port for the web viewer HTTP server
VIEWER_PORT=3007

# First person mode (true) or Bird's-eye top-down view (false)
VIEWER_FIRST_PERSON=false

# Public Web URL to access the viewer from browser / Discord embed (e.g. http://localhost:3007 or your domain/tunnel)
VIEWER_PUBLIC_URL=http://localhost:3007