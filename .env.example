# ==============================================================================
# DISCORD BOT CONFIGURATION
# ==============================================================================
# Token của Discord Bot (Lấy từ Discord Developer Portal)
TOKEN=your_discord_bot_token_here

# ID kênh Discord dùng để nhận thông báo và xác minh Death Regex mới (để trống nếu dùng kênh livechat)
DEATH_VERIFY_CHANNEL_ID=

# ==============================================================================
# WEB SERVER & ENVIRONMENT
# ==============================================================================
# Bật / Tắt dịch vụ Web Server Backend Express: "true" để bật, "false" để tắt
ENABLE_BACKEND=false

# Cổng chạy API / Web Server Express (Mặc định: 3000 hoặc 8181)
PORT=8181

# Môi trường chạy: "development" (bật log console, tự load ts) hoặc "production"
NODE_ENV=development

# Bật log debug chi tiết: "true" (log chi tiết Playtime, KD, Chat, Quote, Redis) hoặc "false"
DEBUG=true

# ==============================================================================
# DATABASE (MONGODB / MONGOOSE) & CACHE (REDIS)
# ==============================================================================
# Chuỗi kết nối MongoDB (Lưu trữ Player stats, Message logs, Quotes, Deaths, Regex patterns)
MONGODB_URI=mongodb://127.0.0.1:27017/anarchy-bot

# Chuỗi kết nối Redis URL (Dùng cho online players cache, session tracking, ZSET leaderboards)
REDIS_URL=redis://127.0.0.1:6379

# Tiền tố (Prefix) cho các Key lưu trong Redis (Mặc định: anarchy)
REDIS_PREFIX=anarchy



# ==============================================================================
# MINECRAFT BOT AUTHENTICATION
# ==============================================================================
# Chế độ xác thực Minecraft: "offline" (Crack/Non-premium) hoặc "microsoft" (Bản quyền)
AUTH_MODE=offline

# --- Chế độ Offline / Crack ---
# Tên nhân vật trong game (IGN) khi vào server crack
BOT_NAME=mo0nbot

# Mật khẩu đăng nhập AuthMe (/login <pass> hoặc /reg <pass> <pass>)
AUTHME=1011121314

# Mã PIN bảo mật server (/pin <mã>) nếu server yêu cầu
PIN=1111

# --- Chế độ Microsoft (Bản quyền) ---
# Email tài khoản Microsoft
EMAIL="your_microsoft_email@gmail.com"

# Mật khẩu tài khoản Microsoft
PASSWORD="your_microsoft_password"

